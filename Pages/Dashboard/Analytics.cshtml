@page
@model PennyWise.Pages.Dashboard.AnalyticsModel
@using PennyWise.Data.Entities
@{
    ViewData["Title"] = "Analytics";
}

<section class="dashboard">
    <div class="dashboard__header">
        <div>
            <span class="dashboard__eyebrow">Trend Analysis</span>
            <h1>Analytics</h1>
            <p>Review monthly financial performance, savings behavior, and category-level patterns.</p>
        </div>
        <div class="dashboard__action">Recent window</div>
    </div>

    <div class="stats-grid">
        @foreach (var m in Model.Metrics)
        {
            <article class="metric-card">
                <div class="metric-card__top">
                    <span class="metric-card__label">@m.Label</span>
                    <span class="metric-card__trend metric-card__trend--@m.TrendDirection">@m.Trend</span>
                </div>
                <div class="metric-card__value">@m.Value</div>
                <div class="metric-card__label">@m.Subtitle</div>
            </article>
        }
    </div>

    <div class="analytics-grid">
        <section class="panel">
            <div class="panel__header">
                <div>
                    <h2>Financial Trend</h2>
                    <p>Income, expenses, and savings across recent active months.</p>
                </div>
            </div>

            <svg class="line-chart" viewBox="0 0 920 360" role="img" aria-label="Six-month financial trend">
                <rect class="chart-bg" x="0" y="0" width="920" height="360" />
                <g stroke="#e7eaf2" stroke-width="1">
                    @foreach (var label in Model.TrendChart.YAxisLabels)
                    {
                        <line x1="70" y1="@label.GridY" x2="880" y2="@label.GridY" />
                    }
                </g>
                <g stroke="#dfe3ee" stroke-width="1">
                    @foreach (var label in Model.TrendChart.MonthLabels)
                    {
                        <line x1="@label.X" y1="40" x2="@label.X" y2="320" />
                    }
                </g>

                @if (Model.TrendChart.HasData)
                {
                    <polyline fill="none" stroke="#14b8a6" stroke-width="3.5" points="@Model.TrendChart.IncomePoints" />
                    <polyline fill="none" stroke="#4f46e5" stroke-width="3.5" points="@Model.TrendChart.ExpensePoints" />
                    <polyline fill="none" stroke="#9aa8f5" stroke-width="3.5" points="@Model.TrendChart.SavingsPoints" />

                    <g fill="#14b8a6">
                        @foreach (var point in Model.TrendChart.IncomeMarkers)
                        {
                            <a href="/transactions?Month=@point.Month&amp;Year=@point.Year&amp;Filter.Type=@TransactionType.Income">
                                <circle class="chart-point" cx="@point.X" cy="@point.Y" r="5" tabindex="0" data-chart-title="@point.Label" data-chart-value="@point.Value" aria-label="@point.Label @point.Value" />
                            </a>
                        }
                    </g>
                    <g fill="#4f46e5">
                        @foreach (var point in Model.TrendChart.ExpenseMarkers)
                        {
                            <a href="/transactions?Month=@point.Month&amp;Year=@point.Year&amp;Filter.Type=@TransactionType.Expense">
                                <circle class="chart-point" cx="@point.X" cy="@point.Y" r="5" tabindex="0" data-chart-title="@point.Label" data-chart-value="@point.Value" aria-label="@point.Label @point.Value" />
                            </a>
                        }
                    </g>
                    <g fill="#9aa8f5">
                        @foreach (var point in Model.TrendChart.SavingsMarkers)
                        {
                            <a href="/transactions?Month=@point.Month&amp;Year=@point.Year">
                                <circle class="chart-point" cx="@point.X" cy="@point.Y" r="5" tabindex="0" data-chart-title="@point.Label" data-chart-value="@point.Value" aria-label="@point.Label @point.Value" />
                            </a>
                        }
                    </g>

                    <rect class="chart-tooltip-bg" x="690" y="150" width="170" height="94" rx="14" />
                    @:<text class="chart-tooltip-text" x="710" y="178" font-size="18" font-family="Nunito, Segoe UI, sans-serif">@Model.TrendChart.Tooltip.Month</text>
                    @:<text x="710" y="204" fill="#14b8a6" font-size="16" font-family="Nunito, Segoe UI, sans-serif">Income : @Model.TrendChart.Tooltip.Income</text>
                    @:<text x="710" y="232" fill="#4f46e5" font-size="16" font-family="Nunito, Segoe UI, sans-serif">Expenses : @Model.TrendChart.Tooltip.Expenses</text>
                    @:<text x="710" y="260" fill="#9aa8f5" font-size="16" font-family="Nunito, Segoe UI, sans-serif">Savings : @Model.TrendChart.Tooltip.Savings</text>
                }
                else
                {
                    @:<text class="chart-empty-text" x="475" y="180" text-anchor="middle">Add transactions to build your trend.</text>
                }

                <g fill="#8b96ad" font-size="14" font-family="Nunito, Segoe UI, sans-serif">
                    @foreach (var label in Model.TrendChart.YAxisLabels)
                    {
                        @:<text x="@label.X" y="@label.Y" text-anchor="end">@label.Text</text>
                    }
                    @foreach (var label in Model.TrendChart.MonthLabels)
                    {
                        @:<text x="@label.X" y="@label.Y" text-anchor="middle">@label.Text</text>
                    }
                </g>
            </svg>
        </section>

        <section class="panel">
            <div class="panel__header">
                <div>
                    <h2>Savings Breakdown</h2>
                    <p>How each month contributes to retained cash.</p>
                </div>
            </div>
            <div class="donut-meta">
                @foreach (var s in Model.SavingsBreakdown)
                {
                    <div class="donut-row">
                        <span class="donut-row__swatch" style="background:@s.Color;"></span>
                        <span>@s.Month</span>
                        <strong>@s.Amount.ToString("C0")</strong>
                    </div>
                }
            </div>
        </section>
    </div>
</section>
