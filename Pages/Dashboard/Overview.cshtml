@page
@model PennyWise.Pages.Dashboard.OverviewModel
@using PennyWise.Data.Entities
@{
    ViewData["Title"] = "Overview";
    var currentMonth = DateTime.UtcNow.Month;
    var currentYear = DateTime.UtcNow.Year;
}

<section class="dashboard">
    <div class="dashboard__header">
        <div>
            <span class="dashboard__eyebrow">Financial Snapshot</span>
            <h1>Overview Dashboard</h1>
            <p>Track income, expenses, savings, and recent activity from one high-level workspace.</p>
        </div>
        <div class="dashboard__action">@Model.LastUpdated</div>
    </div>

    <div class="stats-grid">
        @foreach (var m in Model.Metrics)
        {
            <article class="metric-card">
                <div class="metric-card__top">
                    <span class="metric-card__icon metric-card__icon--@m.IconStyle">@m.Icon</span>
                    <span class="metric-card__trend @(string.IsNullOrEmpty(m.TrendDirection) ? "" : $"metric-card__trend--{m.TrendDirection}")">@m.Trend</span>
                </div>
                <div>
                    <div class="metric-card__label">@m.Label</div>
                    <div class="metric-card__value">@m.Value</div>
                </div>
            </article>
        }
    </div>

    <div class="overview-grid">
        <section class="panel">
            <div class="panel__header">
                <div>
                    <h2>Income vs Expenses</h2>
                    <p>Recent cash flow from months with activity.</p>
                </div>
                <div class="panel__legend">
                    <span style="color:#14b8a6;">Income</span>
                    <span style="color:#4f46e5;">Expenses</span>
                    <span style="color:#9aa8f5;">Savings</span>
                </div>
            </div>

            <svg class="line-chart" viewBox="0 0 920 360" role="img" aria-label="Income and expenses over six months">
                <rect class="chart-bg" x="0" y="0" width="920" height="360" />
                <g stroke="#e7eaf2" stroke-width="1">
                    @foreach (var label in Model.TrendChart.YAxisLabels)
                    {
                        <line x1="70" y1="@label.GridY" x2="880" y2="@label.GridY" />
                    }
                </g>
                <g stroke="#dfe3ee" stroke-width="1">
                    @foreach (var label in Model.TrendChart.MonthLabels)
                    {
                        <line x1="@label.X" y1="40" x2="@label.X" y2="320" />
                    }
                </g>

                @if (Model.TrendChart.HasData)
                {
                    <polyline fill="rgba(79,70,229,0.12)" stroke="none" points="@Model.TrendChart.ExpenseAreaPoints" />
                    <polyline fill="none" stroke="#14b8a6" stroke-width="3.5" points="@Model.TrendChart.IncomePoints" />
                    <polyline fill="none" stroke="#4f46e5" stroke-width="3.5" points="@Model.TrendChart.ExpensePoints" />
                    <polyline fill="none" stroke="#9aa8f5" stroke-width="3.5" points="@Model.TrendChart.SavingsPoints" />

                    <g fill="#14b8a6">
                        @foreach (var point in Model.TrendChart.IncomeMarkers)
                        {
                            <a href="/transactions?Month=@point.Month&amp;Year=@point.Year&amp;Filter.Type=@TransactionType.Income">
                                <circle class="chart-point" cx="@point.X" cy="@point.Y" r="5" tabindex="0" data-chart-title="@point.Label" data-chart-value="@point.Value" aria-label="@point.Label @point.Value" />
                            </a>
                        }
                    </g>
                    <g fill="#4f46e5">
                        @foreach (var point in Model.TrendChart.ExpenseMarkers)
                        {
                            <a href="/transactions?Month=@point.Month&amp;Year=@point.Year&amp;Filter.Type=@TransactionType.Expense">
                                <circle class="chart-point" cx="@point.X" cy="@point.Y" r="5" tabindex="0" data-chart-title="@point.Label" data-chart-value="@point.Value" aria-label="@point.Label @point.Value" />
                            </a>
                        }
                    </g>
                    <g fill="#9aa8f5">
                        @foreach (var point in Model.TrendChart.SavingsMarkers)
                        {
                            <a href="/transactions?Month=@point.Month&amp;Year=@point.Year">
                                <circle class="chart-point" cx="@point.X" cy="@point.Y" r="5" tabindex="0" data-chart-title="@point.Label" data-chart-value="@point.Value" aria-label="@point.Label @point.Value" />
                            </a>
                        }
                    </g>
                }
                else
                {
                    @:<text class="chart-empty-text" x="475" y="180" text-anchor="middle">Add transactions to build your trend.</text>
                }

                <g fill="#8b96ad" font-size="14" font-family="Nunito, Segoe UI, sans-serif">
                    @foreach (var label in Model.TrendChart.YAxisLabels)
                    {
                        @:<text x="@label.X" y="@label.Y" text-anchor="end">@label.Text</text>
                    }
                    @foreach (var label in Model.TrendChart.MonthLabels)
                    {
                        @:<text x="@label.X" y="@label.Y" text-anchor="middle">@label.Text</text>
                    }
                </g>
            </svg>
        </section>

        <section class="panel">
            <div class="panel__header">
                <div>
                    <h2>Spending by Category</h2>
                    <p>Largest cost centers this month.</p>
                </div>
            </div>

            <div class="donut-wrap">
                <svg class="donut-chart" viewBox="0 0 220 220" role="img" aria-label="Spending by category">
                    <circle class="donut-bg" cx="110" cy="110" r="68" fill="none" stroke-width="28" />
                    @foreach (var segment in Model.SpendingSegments)
                    {
                        <a href="/transactions?Month=@currentMonth&amp;Year=@currentYear&amp;Filter.CategoryId=@segment.CategoryId&amp;Filter.Type=@TransactionType.Expense">
                            <circle class="donut-segment" cx="110" cy="110" r="68" fill="none" stroke="@segment.Color" stroke-width="28" stroke-linecap="round" stroke-dasharray="@segment.DashArray" stroke-dashoffset="@segment.DashOffset" transform="rotate(-90 110 110)" tabindex="0" data-chart-title="@segment.Label" data-chart-value="@segment.Value (@segment.Percentage)" aria-label="@segment.Label @segment.Value @segment.Percentage" />
                        </a>
                    }
                    <circle cx="110" cy="110" r="42" fill="#fff" />
                    @if (Model.SpendingSegments.Count == 0)
                    {
                        @:<text class="chart-empty-text" x="110" y="114" text-anchor="middle">No spend</text>
                    }
                </svg>

                <div class="donut-meta">
                    @foreach (var cat in Model.SpendingCategories)
                    {
                        <a class="donut-row" href="/transactions?Month=@currentMonth&amp;Year=@currentYear&amp;Filter.CategoryId=@cat.CategoryId&amp;Filter.Type=@TransactionType.Expense">
                            <span class="donut-row__swatch" style="background:@cat.Color;"></span>
                            <span>@cat.Name</span>
                            <strong>@cat.Amount.ToString("C0")</strong>
                        </a>
                    }
                </div>
            </div>
        </section>
    </div>

    <section class="panel list-panel">
        <div class="list-panel__header">
            <h2>Recent Transactions</h2>
        </div>
        <div class="transaction-list">
            @if (Model.RecentTransactions.Count == 0)
            {
                <div class="empty-state">
                    <div>Add your first transaction, upload a statement, create a budget, or set a savings goal.</div>
                    <div class="empty-state__actions">
                        <a asp-page="/Dashboard/Transactions" class="btn signup-btn">Add transaction</a>
                        <a asp-page="/Dashboard/Budgets" class="btn signup-btn">Create budget</a>
                        <a asp-page="/Dashboard/Goals" class="btn signup-btn">Set savings goal</a>
                    </div>
                </div>
            }
            else
            {
                @foreach (var tx in Model.RecentTransactions)
                {
                    <article class="transaction-item">
                        <div class="transaction-item__icon @(tx.IsIncome ? "transaction-item__icon--income" : "")">@tx.IconLetter</div>
                        <div>
                            <div class="transaction-item__title">@tx.Title</div>
                            <div class="transaction-item__meta">@tx.Category</div>
                        </div>
                        <div class="transaction-item__amount @(tx.IsIncome ? "transaction-item__amount--positive" : "")">
                            @tx.Amount
                            <div class="transaction-item__when">@tx.When</div>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</section>
