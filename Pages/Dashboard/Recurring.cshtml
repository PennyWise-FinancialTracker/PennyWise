@page
@model PennyWise.Pages.Dashboard.RecurringModel
@using PennyWise.Data.Entities
@{
    ViewData["Title"] = "Recurring";
}

<section class="dashboard">
    <div class="dashboard__header">
        <div>
            <span class="dashboard__eyebrow">Recurring Activity</span>
            <h1>Recurring Transactions</h1>
            <p>Set up income and bills on weekly, monthly, or annual schedules. Due items run automatically each day.</p>
        </div>
        <form method="post" asp-page-handler="Generate">
            <button class="dashboard__action action-button" type="submit">Run now</button>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success" role="alert">@Model.Message</div>
    }

    <section class="data-entry-panel">
        <div class="panel__header">
            <div>
                <h2>Add Recurring Rule</h2>
                <p>Examples: paycheck, rent, phone bill, subscriptions.</p>
            </div>
        </div>
        <form method="post" asp-page-handler="Add" class="entry-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-grid form-grid--transactions">
                <div>
                    <label asp-for="Input.Description" class="form-label"></label>
                    <input asp-for="Input.Description" class="form-control" placeholder="Rent, Paycheck, Netflix..." />
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Input.CategoryId" class="form-label">Category</label>
                    <select asp-for="Input.CategoryId" class="form-control">
                        <option value="">Choose category</option>
                        @foreach (var category in Model.CategoryOptions)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CategoryId" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Input.AccountId" class="form-label">Account</label>
                    <select asp-for="Input.AccountId" class="form-control">
                        <option value="">Unassigned</option>
                        @foreach (var account in Model.AccountOptions)
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="Input.Type" class="form-label"></label>
                    <select asp-for="Input.Type" class="form-control">
                        <option value="@TransactionType.Expense">Expense</option>
                        <option value="@TransactionType.Income">Income</option>
                    </select>
                </div>
                <div>
                    <label asp-for="Input.Amount" class="form-label"></label>
                    <input asp-for="Input.Amount" class="form-control" type="number" min="0.01" step="0.01" placeholder="0.00" />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Input.Frequency" class="form-label">Frequency</label>
                    <select asp-for="Input.Frequency" class="form-control">
                        <option value="@RecurringFrequency.Weekly">Weekly</option>
                        <option value="@RecurringFrequency.BiWeekly">Bi-weekly</option>
                        <option value="@RecurringFrequency.Monthly">Monthly</option>
                        <option value="@RecurringFrequency.Quarterly">Quarterly</option>
                        <option value="@RecurringFrequency.Annual">Annual</option>
                    </select>
                </div>
                <div>
                    <label asp-for="Input.StartDate" class="form-label"></label>
                    <input asp-for="Input.StartDate" class="form-control" type="date" />
                </div>
                <div class="entry-form__action">
                    <button type="submit" class="btn login-btn">Add rule</button>
                </div>
            </div>
        </form>
    </section>

    <section class="transactions-panel">
        <table class="transactions-table">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Account</th>
                    <th>Frequency</th>
                    <th>Next Due</th>
                    <th>Last Generated</th>
                    <th class="amount-cell">Amount</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecurringTransactions.Count == 0)
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <div>Add monthly income or bills to generate recurring activity.</div>
                                <div class="empty-state__actions">
                                    <a href="#Input_Description" class="btn signup-btn">Add recurring rule</a>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.RecurringTransactions)
                    {
                        <tr>
                            <td>@item.Description</td>
                            <td><span class="table-tag table-tag--category">@item.Category</span></td>
                            <td>@item.Account</td>
                            <td>@item.FrequencyLabel</td>
                            <td>@item.NextDue</td>
                            <td>@item.LastGenerated</td>
                            <td class="amount-cell @(item.IsIncome ? "amount-cell--positive" : "")">@item.Amount</td>
                            <td>
                                <details class="row-actions">
                                    <summary>Edit</summary>
                                    <form method="post" asp-page-handler="Edit" class="inline-edit-form">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input class="form-control" name="description" value="@item.Description" />
                                        <select class="form-control" name="categoryId">
                                            @foreach (var category in Model.CategoryOptions)
                                            {
                                                <option value="@category.Id" selected="@(category.Id == item.CategoryId ? "selected" : null)">@category.Name</option>
                                            }
                                        </select>
                                        <select class="form-control" name="accountId">
                                            <option value="">Unassigned</option>
                                            @foreach (var account in Model.AccountOptions)
                                            {
                                                <option value="@account.Id" selected="@(account.Id == item.AccountId ? "selected" : null)">@account.Name</option>
                                            }
                                        </select>
                                        <select class="form-control" name="type">
                                            <option value="@TransactionType.Expense" selected="@(item.Type == TransactionType.Expense ? "selected" : null)">Expense</option>
                                            <option value="@TransactionType.Income" selected="@(item.Type == TransactionType.Income ? "selected" : null)">Income</option>
                                        </select>
                                        <input class="form-control" type="number" min="0.01" step="0.01" name="amount" value="@item.RawAmount" />
                                        <select class="form-control" name="frequency">
                                            <option value="@RecurringFrequency.Weekly" selected="@(item.Frequency == RecurringFrequency.Weekly ? "selected" : null)">Weekly</option>
                                            <option value="@RecurringFrequency.BiWeekly" selected="@(item.Frequency == RecurringFrequency.BiWeekly ? "selected" : null)">Bi-weekly</option>
                                            <option value="@RecurringFrequency.Monthly" selected="@(item.Frequency == RecurringFrequency.Monthly ? "selected" : null)">Monthly</option>
                                            <option value="@RecurringFrequency.Quarterly" selected="@(item.Frequency == RecurringFrequency.Quarterly ? "selected" : null)">Quarterly</option>
                                            <option value="@RecurringFrequency.Annual" selected="@(item.Frequency == RecurringFrequency.Annual ? "selected" : null)">Annual</option>
                                        </select>
                                        <input class="form-control" type="date" name="startDate" value="@item.StartDate.ToString("yyyy-MM-dd")" />
                                        <label class="form-check">
                                            <input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@(item.IsActive ? "checked" : null)" />
                                            <span class="form-check-label">Active</span>
                                        </label>
                                        <button class="btn login-btn" type="submit">Save</button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" class="inline-delete-form">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn danger-btn" type="submit" onclick="return confirm('Delete this recurring rule?')">Delete</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </section>
</section>
