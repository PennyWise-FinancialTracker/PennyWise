@page
@model PennyWise.Pages.Dashboard.TransactionsModel
@{
    ViewData["Title"] = "Transactions";
}

<section class="dashboard">
    <div class="dashboard__header">
        <div>
            <span class="dashboard__eyebrow">Ledger View</span>
            <h1>Transactions</h1>
            <p>Search, filter, and review transaction activity across income and expenses.</p>
        </div>
        <div class="dashboard__action">@Model.Period</div>
    </div>

    <section class="transactions-panel">
        <div class="transactions-toolbar">
            <div class="search-box">
                <input type="text" value="" placeholder="Search transactions..." aria-label="Search transactions" />
            </div>
            <div class="filter-pills" aria-label="Transaction filters">
                <span class="filter-pill is-active">All</span>
                <span class="filter-pill">Income</span>
                <span class="filter-pill">Expenses</span>
            </div>
        </div>

        <table class="transactions-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th class="amount-cell">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model.Transactions)
                {
                    <tr>
                        <td>@tx.Date</td>
                        <td>@tx.Description</td>
                        <td><span class="table-tag table-tag--category">@tx.Category</span></td>
                        <td>
                            <span class="table-tag @(tx.IsIncome ? "table-tag--income" : "table-tag--expense")">
                                @(tx.IsIncome ? "Income" : "Expense")
                            </span>
                        </td>
                        <td class="amount-cell @(tx.IsIncome ? "amount-cell--positive" : "")">@tx.Amount</td>
                    </tr>
                }
            </tbody>
        </table>

        @* Mobile card layout (hidden on desktop, shown on small screens) *@
        <div class="transactions-cards">
            @foreach (var tx in Model.Transactions)
            {
                <div class="transaction-card">
                    <div class="transaction-card__top">
                        <span class="transaction-card__desc">@tx.Description</span>
                        <span class="transaction-card__amount @(tx.IsIncome ? "amount-cell--positive" : "")">@tx.Amount</span>
                    </div>
                    <div class="transaction-card__bottom">
                        <span class="transaction-card__date">@tx.Date</span>
                        <span class="table-tag table-tag--category">@tx.Category</span>
                        <span class="table-tag @(tx.IsIncome ? "table-tag--income" : "table-tag--expense")">
                            @(tx.IsIncome ? "Income" : "Expense")
                        </span>
                    </div>
                </div>
            }
        </div>
    </section>
</section>
