@{
    var currentPage = ViewContext.ActionDescriptor.RouteValues["page"] ?? string.Empty;
    var isAuthPage = currentPage.StartsWith("/Auth", StringComparison.OrdinalIgnoreCase);
    var isDashboardPage = !isAuthPage &&
        !string.Equals(currentPage, "/Privacy", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(currentPage, "/Error", StringComparison.OrdinalIgnoreCase);

    string NavState(string page) =>
        string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "app-nav__link is-active" : "app-nav__link";
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PennyWise</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PennyWise.styles.css" asp-append-version="true" />
    <script>
        (function() {
            var saved = localStorage.getItem('pw-theme');
            if (saved) document.documentElement.setAttribute('data-theme', saved);
        })();
    </script>
</head>
<body class="@(isDashboardPage ? "dashboard-body" : "auth-body")">
    <header class="app-header">
        <nav class="app-shell">
            <a class="app-brand" asp-page="/Dashboard/Overview">
                <span class="app-brand__mark">$</span>
                <span class="app-brand__text">PennyWise</span>
            </a>

            @if (isDashboardPage)
            {
                <div class="app-shell__menu">
                    <a class="@NavState("/Dashboard/Overview")" asp-page="/Dashboard/Overview">Overview</a>
                    <a class="@NavState("/Dashboard/Transactions")" asp-page="/Dashboard/Transactions">Transactions</a>
                    <a class="@NavState("/Dashboard/Accounts")" asp-page="/Dashboard/Accounts">Accounts</a>
                    <a class="@NavState("/Dashboard/Budgets")" asp-page="/Dashboard/Budgets">Budgets</a>
                    <a class="@NavState("/Dashboard/Categories")" asp-page="/Dashboard/Categories">Categories</a>
                    <a class="@NavState("/Dashboard/Recurring")" asp-page="/Dashboard/Recurring">Recurring</a>
                    <a class="@NavState("/Dashboard/Goals")" asp-page="/Dashboard/Goals">Goals</a>
                    <a class="@NavState("/Dashboard/Analytics")" asp-page="/Dashboard/Analytics">Analytics</a>
                    <a class="@NavState("/Dashboard/Settings")" asp-page="/Dashboard/Settings">Settings</a>
                </div>

                <div class="app-shell__actions">
                    <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle dark mode">
                        <span class="theme-toggle__icon theme-toggle__icon--light">&#9788;</span>
                        <span class="theme-toggle__icon theme-toggle__icon--dark">&#9790;</span>
                    </button>
                    <a class="app-nav__link" href="/logout">Logout</a>
                </div>
            }
            else
            {
                <div class="app-shell__menu app-shell__menu--auth">
                    <a class="@NavState("/Auth/Login")" asp-page="/Auth/Login">Login</a>
                    <a class="@NavState("/Auth/Signup")" asp-page="/Auth/Signup">Sign up</a>
                    <a class="@NavState("/Privacy")" asp-page="/Privacy">Privacy</a>
                    <button class="theme-toggle" id="themeToggleAuth" type="button" aria-label="Toggle dark mode">
                        <span class="theme-toggle__icon theme-toggle__icon--light">&#9788;</span>
                        <span class="theme-toggle__icon theme-toggle__icon--dark">&#9790;</span>
                    </button>
                </div>
            }
        </nav>
    </header>

    <main class="page-shell page-fade @(isDashboardPage ? "page-shell--dashboard" : "page-shell--auth")" role="main">
        @RenderBody()
    </main>

    @if (!isDashboardPage)
    {
        <footer class="app-footer">
            <div class="app-footer__inner">
                <span>&copy; 2026 PennyWise</span>
                <a asp-page="/Privacy">Privacy</a>
            </div>
        </footer>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
